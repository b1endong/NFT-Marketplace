# RPC Sepolia dùng để đọc dữ liệu (mặc định: publicnode).
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Địa chỉ contract (mặc định: bản deploy trong contract/broadcast).
VITE_NFT_ADDRESS=0x061668d46d4cd5e8b99baf8e18b9cff6c348d95c
VITE_MARKETPLACE_ADDRESS=0x16b64458f52eecd8b4a1d61c747678a9ada21c55
VITE_AUCTION_ADDRESS=0x178793ec0531188365663063e9e2d27c4f466ad0
#Block deploy KSeaNFT (để quét sự kiện mint, tìm người tạo NFT).
VITE_NFT_DEPLOY_BLOCK=9096185

# Pinata JWT để upload ảnh + metadata lên IPFS (https://app.pinata.cloud/developers/api-keys).
# LƯU Ý: biến VITE_* được nhúng vào bundle phía client -> chỉ dùng key giới hạn quyền cho dự án học tập.
# Không có JWT: nhập URL ảnh, metadata được lưu on-chain dạng data URI.
VITE_PINATA_JWT= eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..6aRIHWFAtL7vYbe3rJhfomRZiWWIagy45Q_6DTEFRJ4

# Gateway IPFS ưu tiên (nên dùng dedicated gateway của Pinata: https://<tên>.mypinata.cloud/ipfs/).
VITE_IPFS_GATEWAY= https://azure-faithful-heron-645.mypinata.cloud/ipfs/
